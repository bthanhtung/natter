{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Messenger page access to three narrowly scoped native commands.",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": ["https://*.facebook.com", "https://facebook.com"] },
  "permissions": [
    "core:window:allow-start-dragging",
    "allow-set-unread",
    "allow-notify",
    "allow-window-control"
  ]
}
