{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Messenger page access to narrowly scoped native commands; it cannot change preferences.",
  "windows": ["main"],
  "local": false,
  "remote": { "urls": ["https://*.facebook.com", "https://facebook.com"] },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-set-unread",
    "allow-notify",
    "allow-get-theme",
    "allow-open-preferences",
    "allow-open-external"
  ]
}
