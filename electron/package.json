{
  "name": "natter",
  "productName": "Natter",
  "version": "1.0.0",
  "homepage": "https://github.com/bthanhtung/natter",
  "author": "TungDaDev",
  "private": true,
  "description": "An unofficial desktop app for Facebook Messenger, on Chromium, with voice and video calls",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "prestart": "node sync-shared.js",
    "start": "electron .",
    "prebuild": "node sync-shared.js",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.bthanhtung.natter",
    "productName": "Natter",
    "files": [
      "main.js",
      "preload.js",
      "shared/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "../src-tauri/icons/icon.icns",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "Natter uses the camera for Messenger video calls.",
        "NSMicrophoneUsageDescription": "Natter uses the microphone for Messenger calls and voice clips.",
        "NSLocalNetworkUsageDescription": "Natter can connect calls directly to devices on your local network."
      },
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../src-tauri/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "../src-tauri/icons/icon.png",
      "category": "Network",
      "maintainer": "TungDaDev"
    },
    "afterPack": "build-hooks/after-pack.js"
  }
}
