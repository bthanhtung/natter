{
  "name": "pure-messenger-call",
  "productName": "Pure Messenger",
  "version": "0.1.4",
  "private": true,
  "description": "Chat-only Messenger desktop app on Chromium, with voice and video calls",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "main.js",
  "scripts": {
    "prestart": "node sync-shared.js",
    "start": "electron .",
    "prebuild": "node sync-shared.js",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "dev.personal.puremessenger.call",
    "productName": "Pure Messenger",
    "files": [
      "main.js",
      "preload.js",
      "shared/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "../src-tauri/icons/icon.icns",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "extendInfo": {
        "NSCameraUsageDescription": "Pure Messenger uses the camera for Messenger video calls.",
        "NSMicrophoneUsageDescription": "Pure Messenger uses the microphone for Messenger calls and voice clips.",
        "NSLocalNetworkUsageDescription": "Pure Messenger can connect calls directly to devices on your local network."
      },
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../src-tauri/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "../src-tauri/icons/icon.png",
      "category": "Network",
      "maintainer": "TungDaDev"
    },
    "afterPack": "build-hooks/after-pack.js"
  }
}
